{
  "cors": [
    {
      "AllowedOrigins": [
        "http://localhost:5173"
      ],
      "AllowedMethods": [
        "GET",
        "PUT",
        "POST",
        "DELETE"
      ],
      "AllowedHeaders": [
        "*"
      ],
      "ExposeHeaders": [],
      "MaxAgeSeconds": 3000
    }
  ],
  "iam": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ListBucket",
        "Effect": "Allow",
        "Action": [
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::archivacloud-p11"
        ]
      },
      {
        "Sid": "ObjectAccess",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject"
        ],
        "Resource": [
          "arn:aws:s3:::archivacloud-p11/uploads/*"
        ]
      }
    ]
  }
}
